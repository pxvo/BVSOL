# ========================================
# CONFIGURAÇÕES DA API DO GOOGLE PLACES
# ========================================

# API Key do Google Places API
# Obtenha em: https://console.cloud.google.com/
# Exemplo: AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Configurações do negócio
BUSINESS_NAME=Seu Nome da Empresa
BUSINESS_ADDRESS=Sua Cidade, Estado, País

# Configurações do widget
MAX_REVIEWS=6
CACHE_EXPIRY_HOURS=24
ENABLE_GOOGLE_API=true

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================

# Ambiente de desenvolvimento
NODE_ENV=development

# Configurações de debug
DEBUG_GOOGLE_API=true
CONSOLE_LOGS=true

# ========================================
# CONFIGURAÇÕES OPCIONAIS
# ========================================

# Place ID específico (opcional - será encontrado automaticamente se não fornecido)
GOOGLE_PLACE_ID=

# CORS Proxy (para desenvolvimento local)
CORS_PROXY=https://api.allorigins.win/raw?url=

# Fallback para dados offline
USE_FALLBACK_ON_ERROR=true